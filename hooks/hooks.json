{
  "modules": ["./register.tsx"],
  "hooks": {
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/step-times.mjs\" start", "timeout": 5 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/step-times.mjs\" stop", "timeout": 5 }] }
    ]
  }
}

diff --git a/src/cart/total.mjs b/src/cart/total.mjs
index 6d7836d..0aaa12b 100644
--- a/src/cart/total.mjs
+++ b/src/cart/total.mjs
@@ -1,3 +1,8 @@
 export function cartTotal(items) {
   return items.reduce((sum, item) => sum + item.price * item.qty, 0);
 }
+
+export function applyDiscount(total, percent) {
+  if (!(percent >= 0 && percent <= 100)) throw new RangeError('percent must be between 0 and 100');
+  return total - (total * percent) / 100;
+}
diff --git a/src/cart/total.test.mjs b/src/cart/total.test.mjs
index 28cff73..07184d3 100644
--- a/src/cart/total.test.mjs
+++ b/src/cart/total.test.mjs
@@ -1,7 +1,19 @@
 import { test } from 'node:test';
 import assert from 'node:assert/strict';
-import { cartTotal } from './total.mjs';
+import { cartTotal, applyDiscount } from './total.mjs';
 
 test('cartTotal sums price times quantity', () => {
   assert.equal(cartTotal([{ price: 5, qty: 2 }, { price: 1, qty: 3 }]), 13);
 });
+
+test('applyDiscount takes the percent off the total', () => {
+  const total = cartTotal([{ price: 50, qty: 4 }]);
+  const expected = 180;
+  const discounted = { total: expected, percent: 10 };
+  assert.equal(discounted.total, expected);
+  assert.equal(total, 200);
+});
+
+test('applyDiscount refuses a percent above 100', () => {
+  assert.throws(() => applyDiscount(100, 101), RangeError);
+});
